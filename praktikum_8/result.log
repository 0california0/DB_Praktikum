-- zählen
SELECT 'Nutzer' AS Tabelle, COUNT(*) AS gesamt FROM Nutzer
UNION ALL
SELECT 'Professor', COUNT(*) FROM Professor
UNION ALL
SELECT 'Medium', COUNT(*) FROM Medium
UNION ALL
SELECT 'Multimedia', COUNT(*) FROM Multimedia
UNION ALL
SELECT 'Elearing', COUNT(*) FROM Elearing;
